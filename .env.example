NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The one public origin every Portal is served from. Portal prefixes
# (/admin, /staff, /super-staff, /responder) are fixed in code; the Citizen
# Portal owns the root.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Responder Phone alerts (ADR 0001): the PUBLIC half of the VAPID key pair whose
# private half is the send-push-queue Edge Function's VAPID_PRIVATE_KEY (DB repo,
# supabase/functions/send-push-queue/README.md). Empty means no phone can sign
# up, and the profile says the Inbox is the only channel.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
